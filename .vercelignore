# Не загружать на Vercel: секреты и тяжёлые локальные папки.
# Переменные окружения берутся из настроек проекта Vercel, а не из .env.
.env
.env.*

# Референс-копия duolingo-clone и архив старого проекта — только для локальной разработки.
duo/
_archive_old_project/

# Локальные сборки и кэши E2E — Vercel соберёт приложение заново.
.next-e2e/

# Локальные результаты проверок.
test-results/
playwright-report/
coverage/

# Бэкапы содержат данные учеников и никогда не должны загружаться.
backups/

# Нелицензированные визуальные референсы — не часть production.
assets ux/
